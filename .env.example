# =====================================================================
# KJT TECHNOLOGIES - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets to Git.
#
# SECURITY RULES:
#   Variables prefixed with VITE_ are bundled into the browser JavaScript
#   bundle and are visible to anyone who opens DevTools. Only place
#   public/safe values in VITE_ variables.
#
#   Variables WITHOUT a VITE_ prefix are server-side only. They are
#   available in Vercel serverless functions (api/ folder) but are never
#   sent to the browser.
# =====================================================================

# ── 1. CLIENT-SIDE — safe for the browser ────────────────────────────

# Supabase project URL and anonymous public key.
# These are safe in the browser because access is governed by Supabase RLS.
# Find them at: https://supabase.com/dashboard -> Project -> Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_public_key

# Canonical website URL (used for SEO canonical tags and sitemap).
# In production set this to your actual domain, e.g. https://kjttechnologies.com
VITE_SITE_URL=http://localhost:5173

# Web3Forms public access key.
# Used for: contact form, quotation requests, consultation booking confirmations.
# Sign up free at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_key

# ── 2. SERVER-SIDE ONLY — never expose in browser code ───────────────

# Resend transactional email API key.
# Used by: api/newsletter-subscribe.cjs (Vercel serverless function).
# Sends the branded HTML welcome email to new newsletter subscribers.
# Free tier: 3,000 emails/month. Sign up at https://resend.com
# Must be added to Vercel -> Project -> Settings -> Environment Variables.
# DO NOT add a VITE_ prefix to this key.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_KEY

# Supabase service-role key (bypasses Row Level Security — admin operations only).
# Only used in server-side code. Never place in frontend or VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=replace_on_server_only
