# =====================================================================
# KJT TECHNOLOGIES - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# WARNING & SECURITY DIRECTIVES:
# 1. Variables prefixed with 'VITE_' ARE BUNDLED INTO FRONTEND JAVASCRIPT
#    and can be viewed by anyone inspecting network requests in browser DevTools.
# 2. NEVER put database passwords, service-role keys, or private email API keys
#    in VITE_ prefixed variables.
# 3. NEVER commit real credentials, passwords, or actual .env files to Git.
# 4. Copy this file to `.env.local` for local development.
# =====================================================================

# ---------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (PUBLIC / BROWSER-ACCESSIBLE)
# ---------------------------------------------------------------------

# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase Anonymous Public API Key (Dashboard -> Project Settings -> API)
# SECURITY: This is the public anon key. It is safe for the browser because
# database access is strictly governed by Supabase Row Level Security (RLS).
VITE_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_public_key

# Canonical Website URL (Used for generating canonical tags, sitemap, and social cards)
VITE_SITE_URL=http://localhost:5173

# Optional: Web3Forms access key for contact forms and notification relays
# Sign up free at https://web3forms.com to receive form submissions via email
VITE_WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_key

# ---------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (STRICTLY CONFIDENTIAL)
# ---------------------------------------------------------------------
# CRITICAL SECURITY RULES:
# - NEVER PREFIX THESE VARIABLES WITH 'VITE_'
# - These variables must ONLY be configured in Vercel Environment Variables,
#   Supabase Edge Function secrets, or a private backend server.
# - The service-role key MUST NEVER appear in frontend code; it bypasses RLS!

# Private transactional email provider key (e.g., Resend, Brevo, SendGrid)
EMAIL_API_KEY=replace_on_server_only

# Supabase Service Role Key (ONLY for privileged backend serverless execution)
SUPABASE_SERVICE_ROLE_KEY=replace_on_server_only
